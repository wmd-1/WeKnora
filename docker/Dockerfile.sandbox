# WeKnora Sandbox Image
# Pre-built environment for executing agent skill scripts in Docker sandbox

# ------------------------------------------------
# Stage 1: Get Node.js binaries
# ------------------------------------------------
FROM node:20-slim AS node-base

# ------------------------------------------------
# Stage 2: Final image
# ------------------------------------------------
FROM python:3.11-slim

# ------------------------------------------------
# Copy Node.js from node image
# ------------------------------------------------
COPY --from=node-base /usr/local/bin/node /usr/local/bin/
COPY --from=node-base /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# ------------------------------------------------

# Install system packages
# ------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    chromium \
    fonts-noto-cjk \
    graphviz \
    texlive-base \
    texlive-pictures \
    texlive-latex-extra \
    wget \
    curl \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# ------------------------------------------------
# Install .NET 8 SDK
# ------------------------------------------------
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH=$PATH:/usr/share/dotnet:/usr/share/dotnet/tools

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        DOTNET_ARCH="x64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        DOTNET_ARCH="arm64"; \
    else \
        echo "Unsupported architecture: $ARCH"; \
        exit 1; \
    fi && \
    mkdir -p /usr/share/dotnet && \
    wget "https://dotnetcli.azureedge.net/dotnet/Sdk/8.0.117/dotnet-sdk-8.0.117-linux-${DOTNET_ARCH}.tar.gz" -O /tmp/dotnet.tar.gz && \
    tar zxf /tmp/dotnet.tar.gz -C /usr/share/dotnet && \
    rm /tmp/dotnet.tar.gz && \
    dotnet --info

# ------------------------------------------------
# Preinstall OpenXML helper project
# ------------------------------------------------
WORKDIR /opt/openxml-helper

RUN dotnet new console

RUN dotnet add package DocumentFormat.OpenXml --version 3.0.2

# Optional but useful
RUN dotnet add package OpenXmlPowerTools

RUN dotnet restore

# ------------------------------------------------
# Configure Puppeteer
# ------------------------------------------------
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN mkdir -p /etc/mermaid-cli && \
    echo '{ \
      "args": [ \
        "--no-sandbox", \
        "--disable-setuid-sandbox", \
        "--disable-dev-shm-usage", \
        "--disable-gpu", \
        "--headless=new", \
        "--disable-extensions", \
        "--disable-background-networking", \
        "--disable-sync", \
        "--no-first-run", \
        "--disable-default-apps", \
        "--disable-component-update" \
    ] \
    }' > /etc/mermaid-cli/puppeteer-config.json

RUN npm install -g @mermaid-js/mermaid-cli

# ------------------------------------------------
# Bundle mermaid.js
# ------------------------------------------------
RUN mkdir -p /usr/local/share/mermaid && \
    MERMAID_FILE=$(find /usr/local/lib/node_modules -name mermaid.min.js -path "*/dist/*" | head -1) && \
    if [ -z "$MERMAID_FILE" ]; then echo "mermaid.min.js not found"; exit 1; fi && \
    cp "$MERMAID_FILE" /usr/local/share/mermaid/mermaid.min.js && \
    chmod 644 /usr/local/share/mermaid/mermaid.min.js

# ------------------------------------------------
# Install Python packages
# ------------------------------------------------
RUN pip install --no-cache-dir \
    diagrams \
    matplotlib \
    seaborn \
    plotly \
    networkx \
    pillow

# ------------------------------------------------
# Environment variables for OpenXML
# ------------------------------------------------
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

# ------------------------------------------------
# Create sandbox user
# ------------------------------------------------
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/bash sandbox

WORKDIR /workspace

USER sandbox